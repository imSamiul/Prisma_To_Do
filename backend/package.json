{
  "name": "prisma-todo-backend",
  "version": "1.0.0",
  "description": "NestJS backend for Prisma Todo with MongoDB (Prisma) and JWT cookie auth",
  "main": "dist/main.js",
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
